DATABASE_URL=sqlite:///./data/mathcraft.db
REDIS_URL=redis://127.0.0.1:6379/0

# DeepSeek 密钥优先取每个用户在个人中心的配置，此处仅兜底
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_DISPLAY_NAME=DeepSeek Flash

# 模型调用与出题中间件：默认值即可用，按部署环境调整
LLM_TIMEOUT_SECONDS=300
REVIEW_SIMILARITY_THRESHOLD=0.92
REVIEW_MAX_REGEN_ROUNDS=1
REVIEW_CORPUS_LIMIT=300

CHROMA_DIR=data/chroma
UPLOAD_DIR=data/uploads
OCR_DIR=data/ocr

CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 用户认证：生产必须显式设置 production；下面秘密值均为空，不提供默认密钥
APP_ENV=development
# 在 backend 目录安装依赖后，手动执行 uv run python scripts/init_auth_secrets.py 初始化下面两项
# 仅补缺项或空值，保留已有合法密钥且不打印秘密值；生产也可使用受控秘密注入
# 两项独立生成；同一部署各实例保持一致，切勿每次启动重新生成
AUTH_JWT_SECRET=
AUTH_CODE_SECRET=
AUTH_JWT_ISSUER=mathcraft
AUTH_JWT_AUDIENCE=mathcraft-web
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=604800
AUTH_CODE_TTL_SECONDS=300
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_CODE_RETRY_SECONDS=60
AUTH_CODE_EMAIL_HOUR_LIMIT=5
AUTH_CODE_IP_HOUR_LIMIT=30

# Turnstile：本模板用于本机开发，配合 APP_ENV=development 持久关闭人机验证
# 仅实际回环请求可跳过；以 --host 127.0.0.1 --no-proxy-headers 启动后端
# 生产必须设 APP_ENV=production、TURNSTILE_ENABLED=true，并配置下方真实站点密钥及 hostname
# 开启验证时从 Cloudflare 控制台获取密钥，不能用本地随机密钥代替；修改后重启后端并刷新页面
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1

# SMTP：从邮件服务商获取服务器、账号及 SMTP 密码/授权码
# 根据邮件服务选择 starttls 或 tls；密码不入库
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT_SECONDS=10
TURNSTILE_TIMEOUT_SECONDS=10

# 仅受控本机开发；显式执行初始化命令，生产必须 false 且清空下方所有账号字段
DEV_ACCOUNTS_ENABLED=false
DEV_TEACHER_EMAIL=
DEV_TEACHER_USER_NO=
DEV_TEACHER_PASSWORD=
DEV_TEACHER_DISPLAY_NAME=
DEV_STUDENT_EMAIL=
DEV_STUDENT_USER_NO=
DEV_STUDENT_PASSWORD=
DEV_STUDENT_DISPLAY_NAME=
# 公开的管理员联系提示
ADMIN_CONTACT=请联系本校或平台管理员
