DATABASE_URL=sqlite:///./data/mathcraft.db
REDIS_URL=redis://127.0.0.1:6379/0

# DeepSeek 密钥优先取每个用户在个人中心的配置，此处仅兜底
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

CHROMA_DIR=data/chroma
UPLOAD_DIR=data/uploads
OCR_DIR=data/ocr

CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 用户认证：生产必须显式设置 production；下面秘密值均为空，不提供默认密钥
APP_ENV=development
AUTH_JWT_SECRET=
AUTH_CODE_SECRET=
AUTH_JWT_ISSUER=mathcraft
AUTH_JWT_AUDIENCE=mathcraft-web
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=604800
AUTH_CODE_TTL_SECONDS=300
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_CODE_RETRY_SECONDS=60
AUTH_CODE_EMAIL_HOUR_LIMIT=5
AUTH_CODE_IP_HOUR_LIMIT=30

# Turnstile：开发使用官方测试密钥对，生产必须真实配置并限制站点 hostname
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1

# SMTP：根据邮件服务选择 starttls 或 tls；密码不入库
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT_SECONDS=10
TURNSTILE_TIMEOUT_SECONDS=10

# 仅受控本机开发；显式执行初始化命令，生产必须 false
DEV_ACCOUNTS_ENABLED=false
DEV_TEACHER_EMAIL=
DEV_TEACHER_USER_NO=
DEV_TEACHER_PASSWORD=
DEV_TEACHER_DISPLAY_NAME=
DEV_STUDENT_EMAIL=
DEV_STUDENT_USER_NO=
DEV_STUDENT_PASSWORD=
DEV_STUDENT_DISPLAY_NAME=