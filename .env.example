# Single-tenant data root. Defaults to the repository root when unset.
# Runtime data lives under <MATH_Q_HOME>/data.
MATH_Q_HOME=

# Optional: force server mode (only "server" is meaningful for this service).
MATH_Q_MODE=server

# Optional: bind address/port used by `python -m math_q_agent`.
BACKEND_PORT=8001

# Optional: extra browser origins allowed by CORS (comma separated).
CORS_ORIGIN=

# Model, provider, embedding and parsing configuration is NOT configured here.
# It lives in <MATH_Q_HOME>/data/user/settings/model_catalog.json and
# document_parsing.json, and is managed through /api/settings.
