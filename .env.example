# Single-tenant data root. Defaults to the repository root when unset.
# Runtime data lives under <MATH_Q_HOME>/data.
MATH_Q_HOME=

# Optional: force server mode (only "server" is meaningful for this service).
MATH_Q_MODE=server

# Bind address/port used by `python -m MathCraft` (also the built-in defaults).
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Vite development server (also the built-in defaults).
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
# Vite preview server.
FRONTEND_PREVIEW_PORT=4173
# Optional internal development/preview proxy URL; empty derives from BACKEND_*.
FRONTEND_PROXY_TARGET=
# Browser API URL; empty uses the current origin and the development proxy.
VITE_API_BASE_URL=
# Optional public WebSocket URL; empty follows VITE_API_BASE_URL or the page origin.
VITE_WS_BASE_URL=

# Optional: extra browser origins allowed by CORS (comma separated).
CORS_ORIGIN=
# Optional additional origins (comma separated).
CORS_ORIGINS=

# 模型配置初始化：首次启动且尚无 model_catalog.json 时读取这些变量。
# 前端通过 /api/settings 保存后，model_catalog.json 优先于 .env；后续重启不会覆盖前端配置。
# shell 环境变量优先于同名 .env 值。第一阶段支持 llm、task、embedding。
LLM_BINDING=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_API_FORMAT=
LLM_API_VERSION=
TASK_BINDING=
TASK_MODEL=
TASK_API_KEY=
TASK_BASE_URL=
TASK_API_FORMAT=
TASK_API_VERSION=
# 可选：inherit、profiles 或 reference；默认 profiles。
TASK_MODE=profiles
EMBEDDING_BINDING=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_API_FORMAT=
EMBEDDING_API_VERSION=
EMBEDDING_DIMENSION=

# 持久化设置位于 <MATH_Q_HOME>/data/user/settings/。

# MinerU 云端 OCR（扫描型 PDF 强制使用；Token 仅在本机 .env 配置）
# shell 中已有的同名变量优先于 .env；这些变量会覆盖 document_parsing.json 的对应字段。
MINERU_MODE=cloud
MINERU_API_BASE_URL=https://mineru.net
MINERU_API_TOKEN=
