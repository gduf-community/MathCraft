# Single-tenant data root. Defaults to the repository root when unset.
# Runtime data lives under <MATH_Q_HOME>/data.
MATH_Q_HOME=

# Optional: force server mode (only "server" is meaningful for this service).
MATH_Q_MODE=server

# Optional: bind address/port used by `python -m math_q_agent`.
BACKEND_PORT=8001

# Optional: extra browser origins allowed by CORS (comma separated).
CORS_ORIGIN=

# Model, provider, embedding and parsing configuration is NOT configured here.
# It lives in <MATH_Q_HOME>/data/user/settings/model_catalog.json and
# document_parsing.json, and is managed through /api/settings.

# --- MathCraft 出题服务（backend/ 下的独立进程，默认端口 8000）------
# 以下变量由出题服务通过 pydantic-settings 从仓库根 .env 读取（铺平后 BASE_DIR 即仓库根），
# 也可在启动前由 shell 提供；真实密钥一律不进 git。
DEEPSEEK_API_KEY=
# 以平台实际可用模型为准（当前支持 deepseek-flash、deepseek-v4-pro）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 向量模型由本地 Ollama 提供
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=qwen3-embedding:0.6b
EMBED_DIM=1024
# 相对仓库根目录解析（BASE_DIR 已随目录铺平指向仓库根）
CHROMA_DIR=data/chroma
UPLOAD_DIR=data/uploads
TOP_K=6
CHUNK_SIZE=500
CHUNK_OVERLAP=100
